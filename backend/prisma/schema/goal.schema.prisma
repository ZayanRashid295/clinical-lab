// Personal study goals: targets per metric per period (daily/weekly/monthly).

model Goal {
  id              String     @id @default(cuid())
  userId          String
  title           String
  description     String?    @db.Text
  metric          GoalMetric
  target          Int
  period          GoalPeriod @default(DAILY)
  startDate       DateTime   @default(now())
  endDate         DateTime?
  isActive        Boolean    @default(true)
  reminderEnabled Boolean    @default(true)
  reminderHour    Int        @default(18) // 0-23, server local
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  progress GoalProgress[]

  @@index([userId, isActive])
  @@map("goals")
}

enum GoalMetric {
  QUESTIONS_ANSWERED
  CORRECT_ANSWERS
  STUDY_MINUTES
  FLASHCARDS_REVIEWED
  NOTES_CREATED
  TESTS_COMPLETED
}

enum GoalPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

model GoalProgress {
  id         String    @id @default(cuid())
  goalId     String
  userId     String
  bucket     String // ISO date for the bucket (YYYY-MM-DD or YYYY-Www or YYYY-MM)
  value      Int       @default(0)
  achieved   Boolean   @default(false)
  achievedAt DateTime?
  updatedAt  DateTime  @updatedAt
  createdAt  DateTime  @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, bucket])
  @@index([userId, bucket])
  @@map("goal_progress")
}
