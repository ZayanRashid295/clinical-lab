// Payout module schema
// This file contains all tables related to driver payouts and earnings

model Payout {
  id            String      @id @default(cuid())
  driverId      String
  amount        Decimal     @db.Decimal(10, 2)
  currency      String      @default("USD")
  status        PayoutStatus @default(PENDING)
  payoutMethod  PayoutMethod
  transactionId String?     @unique
  description   String?
  scheduledAt   DateTime
  processedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Relations
  driver        User        @relation("DriverPayouts", fields: [driverId], references: [id])
  payoutItems   PayoutItem[]
  payoutMethodDetails PayoutMethodDetails?
  earnings      Earnings[]

  @@map("payouts")
}

model PayoutItem {
  id        String  @id @default(cuid())
  payoutId  String
  rideId    String
  amount    Decimal @db.Decimal(10, 2)
  fee       Decimal @db.Decimal(10, 2) // Platform fee deducted
  netAmount Decimal @db.Decimal(10, 2) // Amount after fees
  createdAt DateTime @default(now())

  // Relations
  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  ride   Ride   @relation(fields: [rideId], references: [id])

  @@map("payout_items")
}

model PayoutMethodDetails {
  id            String        @id @default(cuid())
  payoutId      String        @unique
  method        PayoutMethod
  provider      String        // stripe, paypal, bank, etc.
  providerId    String?       // External provider ID
  accountDetails Json?        // Encrypted account details
  metadata      Json?         // Additional method-specific data
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  payout Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  @@map("payout_method_details")
}

model PayoutSchedule {
  id              String          @id @default(cuid())
  driverId        String
  frequency       PayoutFrequency
  dayOfWeek       Int?            // 0-6 (Sunday-Saturday) for weekly
  dayOfMonth      Int?            // 1-31 for monthly
  minimumAmount   Decimal         @db.Decimal(10, 2)
  isActive        Boolean         @default(true)
  lastProcessedAt DateTime?
  nextScheduledAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  driver User @relation("DriverPayoutSchedules", fields: [driverId], references: [id])

  @@map("payout_schedules")
}

model PayoutSettings {
  id                    String          @id @default(cuid())
  driverId              String          @unique
  defaultPayoutMethod   PayoutMethod
  autoPayout            Boolean         @default(false)
  minimumPayoutAmount   Decimal         @db.Decimal(10, 2)
  payoutFrequency       PayoutFrequency @default(WEEKLY)
  taxSettings           Json?           // Tax withholding settings
  notifications         Json?           // Notification preferences
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  // Relations
  driver User @relation("DriverPayoutSettings", fields: [driverId], references: [id])

  @@map("payout_settings")
}

model Earnings {
  id              String   @id @default(cuid())
  driverId        String
  rideId          String
  grossEarnings   Decimal  @db.Decimal(10, 2)
  platformFee     Decimal  @db.Decimal(10, 2)
  netEarnings     Decimal  @db.Decimal(10, 2)
  payoutId        String?  // Null until paid out
  status          EarningsStatus @default(PENDING)
  calculatedAt    DateTime @default(now())
  paidOutAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  driver User  @relation("DriverEarnings", fields: [driverId], references: [id])
  ride   Ride  @relation(fields: [rideId], references: [id])
  payout Payout? @relation(fields: [payoutId], references: [id])

  @@map("earnings")
}

model PayoutFee {
  id          String   @id @default(cuid())
  name        String
  type        FeeType
  value       Decimal  @db.Decimal(10, 2)
  percentage  Decimal? @db.Decimal(5, 4) // For percentage-based fees
  isActive    Boolean  @default(true)
  appliesTo   Json     // Which payout methods this applies to (array of strings)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payout_fees")
}

// Enums
enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PayoutMethod {
  BANK_TRANSFER
  PAYPAL
  STRIPE_CONNECT
  CASH
  WALLET
}

enum PayoutFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  MANUAL
}

enum EarningsStatus {
  PENDING
  PAID_OUT
  DISPUTED
  REFUNDED
}

enum FeeType {
  FIXED
  PERCENTAGE
}
