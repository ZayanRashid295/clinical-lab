// Student-facing schema: bookmarks, notes, study plans, sessions.
// Designed to be self-contained and to use scalar foreign-key columns so it
// can compile with the existing modular schema layout without forcing
// every other model to declare a back-relation.

// ────────────────────────────────────────────────────────────────────────────
// Bookmarks
// One row = a user pinned an entity. Polymorphic on resourceType.
// ────────────────────────────────────────────────────────────────────────────
model Bookmark {
  id           String       @id @default(cuid())
  userId       String
  resourceType BookmarkType
  resourceId   String
  note         String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([userId, resourceType, resourceId])
  @@index([userId, resourceType])
  @@map("bookmarks")
}

enum BookmarkType {
  QUESTION
  TOPIC
  SUBTOPIC
  PRODUCT
  MATERIAL
}

// ────────────────────────────────────────────────────────────────────────────
// Study Plan + Tasks
// One active plan per user (enforced in service layer); tasks scheduled by day.
// ────────────────────────────────────────────────────────────────────────────
model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  name        String   @default("My Study Plan")
  description String?
  goal        String?  @db.Text
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks StudyTask[]

  @@index([userId, isActive])
  @@map("study_plans")
}

model StudyTask {
  id              String          @id @default(cuid())
  studyPlanId     String
  userId          String
  title           String
  description     String?         @db.Text
  type            StudyTaskType   @default(GENERAL)
  scheduledFor    DateTime
  durationMinutes Int             @default(30)
  status          StudyTaskStatus @default(PENDING)
  completedAt     DateTime?
  // Optional context: if this task points to a system / topic / subtopic / question paper
  systemId        String?
  topicId         String?
  subtopicId      String?
  questionPaperId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
  @@index([userId, status])
  @@map("study_tasks")
}

enum StudyTaskType {
  READING
  PRACTICE
  REVIEW
  ASSESSMENT
  GENERAL
}

enum StudyTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

// ────────────────────────────────────────────────────────────────────────────
// Study Sessions
// Generic time-on-task ledger so dashboards can show streaks and time today.
// ────────────────────────────────────────────────────────────────────────────
model StudySession {
  id              String           @id @default(cuid())
  userId          String
  type            StudySessionType @default(STUDY)
  startedAt       DateTime         @default(now())
  endedAt         DateTime?
  durationSeconds Int              @default(0)
  meta            Json?

  @@index([userId, startedAt])
  @@map("study_sessions")
}

enum StudySessionType {
  STUDY
  PRACTICE
  ASSESSMENT
  REVIEW
}
