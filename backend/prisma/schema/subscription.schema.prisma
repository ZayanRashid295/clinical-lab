// Subscription module schema for LMS system
// This file contains tables for subscription packages, features, and user subscriptions

model PackageFeatures {
  id          String   @id @default(cuid())
  name        String   @unique // Qbank, Self Assessment, One Time Reset, Study Planner
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subscriptionFeatures SubscriptionFeatures[]

  @@map("package_features")
}

// New entitlement system (parameterized, production-grade).
// These models are additive and keep existing PackageFeatures working during migration.
//
// Design notes:
// - EntitlementDefinition.key is the stable identifier used by backend guards and frontend logic.
// - SubscriptionPackageEntitlement.valueJson holds parameters/limits/scopes for that entitlement.
// - EntitlementUsage tracks consumption for quota-style entitlements (e.g., AI tutor chat limits).

enum EntitlementType {
  BOOLEAN
  SET
  NUMBER_LIMIT
  JSON_CONSTRAINTS
}

model EntitlementDefinition {
  id             String          @id @default(cuid())
  key            String          @unique // e.g. qbank.access, medprepai.modes, aitutor.chat
  displayName    String
  description    String?
  productSubtypeId String?
  type           EntitlementType @default(BOOLEAN)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Relations
  productSubtype ProductSubtype?                 @relation(fields: [productSubtypeId], references: [id], onDelete: SetNull)
  packageEntitlements SubscriptionPackageEntitlement[]
  usages           EntitlementUsage[]

  @@map("entitlement_definitions")
}

model SubscriptionPackageEntitlement {
  id                   String   @id @default(cuid())
  subscriptionPackageId String
  entitlementDefinitionId String
  valueJson             Json     @default("{}") // typed by EntitlementDefinition.type
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  subscriptionPackage   SubscriptionPackage   @relation(fields: [subscriptionPackageId], references: [id], onDelete: Cascade)
  entitlementDefinition EntitlementDefinition @relation(fields: [entitlementDefinitionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionPackageId, entitlementDefinitionId])
  @@map("subscription_package_entitlements")
}

model EntitlementUsage {
  id                    String   @id @default(cuid())
  userId                String
  entitlementDefinitionId String
  periodStart           DateTime
  periodEnd             DateTime
  usedCount             Int      @default(0)
  metadataJson          Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Relations
  user                  User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entitlementDefinition EntitlementDefinition @relation(fields: [entitlementDefinitionId], references: [id], onDelete: Cascade)

  @@unique([userId, entitlementDefinitionId, periodStart, periodEnd])
  @@index([userId, entitlementDefinitionId])
  @@map("entitlement_usages")
}

model SubscriptionPackage {
  id               String   @id @default(cuid())
  productSubtypeId String
  name             String // Basic, Premium, Pro
  description      String?
  price            Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD")
  validityDays     Int // Number of days the subscription is valid
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  productSubtype       ProductSubtype         @relation(fields: [productSubtypeId], references: [id], onDelete: Cascade)
  subscriptionFeatures SubscriptionFeatures[]
  entitlements         SubscriptionPackageEntitlement[]
  subscriptions        Subscription[]

  @@unique([productSubtypeId, name])
  @@map("subscription_packages")
}

model SubscriptionFeatures {
  id                    String @id @default(cuid())
  subscriptionPackageId String
  packageFeatureId      String

  // Relations
  subscriptionPackage SubscriptionPackage @relation(fields: [subscriptionPackageId], references: [id], onDelete: Cascade)
  packageFeature      PackageFeatures     @relation(fields: [packageFeatureId], references: [id], onDelete: Cascade)

  @@unique([subscriptionPackageId, packageFeatureId])
  @@map("subscription_features")
}

model Subscription {
  id                    String             @id @default(cuid())
  userId                String
  subscriptionPackageId String
  status                SubscriptionStatus @default(ACTIVE)
  startDate             DateTime
  endDate               DateTime
  autoRenew             Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  // Relations
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionPackage SubscriptionPackage @relation(fields: [subscriptionPackageId], references: [id])
  payments            Payment[]

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  SUSPENDED
  PENDING
}
