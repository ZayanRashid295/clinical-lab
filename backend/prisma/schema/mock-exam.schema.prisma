// Mock Exams: full-length timed exams.
// Reuses QuestionPaper for the actual attempt (typed as "mock_exam"), and
// keeps a higher-level definition + history for catalog / analytics.

model MockExam {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  totalQuestions  Int      @default(40)
  durationMinutes Int      @default(60)
  difficulty      String   @default("mixed") // easy | medium | hard | mixed
  productId       String?
  systemIds       Json?
  topicIds        Json?
  isPublished     Boolean  @default(true)
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  attempts MockExamAttempt[]

  @@index([isPublished])
  @@map("mock_exams")
}

model MockExamAttempt {
  id               String                @id @default(cuid())
  mockExamId       String
  userId           String
  questionPaperId  String?               @unique
  status           MockExamAttemptStatus @default(IN_PROGRESS)
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  totalQuestions   Int                   @default(0)
  correctAnswers   Int                   @default(0)
  scorePercent     Float                 @default(0)
  timeSpentSeconds Int                   @default(0)

  mockExam MockExam @relation(fields: [mockExamId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([mockExamId])
  @@map("mock_exam_attempts")
}

enum MockExamAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}
