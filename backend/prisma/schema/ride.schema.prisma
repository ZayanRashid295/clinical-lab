// Ride module schema
// This file contains all tables related to ride functionality

model Ride {
  id          String      @id @default(cuid())
  passengerId String
  driverId    String?
  status      RideStatus  @default(REQUESTED)
  fare        Decimal     @db.Decimal(10, 2)
  distance    Float?      // in kilometers
  duration    Int?        // in minutes
  startTime   DateTime?
  endTime     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Location data
  pickupLocationId  String?
  dropoffLocationId String?
  pickupLocation    Location? @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocation   Location? @relation("DropoffLocation", fields: [dropoffLocationId], references: [id])
  pickupLatitude    Float?
  pickupLongitude   Float?
  dropoffLatitude   Float?
  dropoffLongitude  Float?

  // Additional ride metadata
  metadata    Json?       // Store ride type, passengers, special instructions, etc.

  // Relations
  passenger     User        @relation("PassengerRides", fields: [passengerId], references: [id])
  driver        User?       @relation("DriverRides", fields: [driverId], references: [id])
  payments      Payment[]
  rideReviews   RideReview[]
  rideMessages  RideMessage[]
  payoutItems   PayoutItem[]
  earnings      Earnings[]

  @@map("rides")
}

model RideReview {
  id        String   @id @default(cuid())
  rideId    String
  reviewerId String
  revieweeId String
  rating    Int      // 1-5 stars
  comment   String?
  createdAt DateTime @default(now())

  // Relations
  ride     Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  reviewer User @relation("RideReviewer", fields: [reviewerId], references: [id])
  reviewee User @relation("RideReviewee", fields: [revieweeId], references: [id])

  @@unique([rideId, reviewerId])
  @@map("ride_reviews")
}

model RideMessage {
  id        String   @id @default(cuid())
  rideId    String
  senderId  String
  message   String
  createdAt DateTime @default(now())

  // Relations
  ride   Ride @relation(fields: [rideId], references: [id], onDelete: Cascade)
  sender User @relation("RideMessageSender", fields: [senderId], references: [id])

  @@map("ride_messages")
}

enum RideStatus {
  REQUESTED
  ACCEPTED
  ARRIVING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
