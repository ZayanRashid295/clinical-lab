// Product module schema for LMS system
// This file contains tables for categories, products, systems, and subtypes

model Category {
  id          String   @id @default(cuid())
  name        String   @unique // Medical, Nursing, High School, etc.
  description String?
  icon        String?  // Emoji or icon identifier for UI display
  slug        String   @unique // URL-friendly name: medical, nursing, etc.
  order       Int      @default(0) // Display ordering in navbar
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products Product[]
  questions Question[]

  @@map("categories")
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String?
  name        String   @unique // USMLE, SAT, etc.
  description String?
  isActive    Boolean  @default(true)
  order       Int      @default(0) // Display ordering within category
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category        Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  systems         System[]
  productSubtypes ProductSubtype[]
  questions       Question[]

  @@map("products")
}

model System {
  id          String   @id @default(cuid())
  productId   String
  name        String   @db.VarChar(500) // Cardiovascular, Respiratory, Neurology, etc.
  description String?
  order       Int      @default(0) // For ordering systems
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  topics    Topic[]
  questions Question[]

  @@unique([productId, name])
  @@map("systems")
}

model ProductSubtype {
  id          String   @id @default(cuid())
  productId   String
  name        String   // Qbank, Self-Assessment, Biostatistics Review
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionPackages SubscriptionPackage[]

  @@unique([productId, name])
  @@map("product_subtypes")
}
