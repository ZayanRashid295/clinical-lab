// Notification module schema
// This file contains all tables related to notification functionality

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?            // Additional data for the notification
  isRead    Boolean          @default(false)
  isSent    Boolean          @default(false)
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  // Relations
  user User @relation("UserNotifications", fields: [userId], references: [id])

  @@map("notifications")
}

model NotificationTemplate {
  id          String   @id @default(cuid())
  name        String   @unique
  type        NotificationType
  title       String
  message     String
  // variables   String[] // Array of variable names used in the template
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("notification_templates")
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  smsEnabled   Boolean  @default(false)
  pushEnabled  Boolean  @default(true)
  preferences  Json     @default("{}") // Per-type preferences
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("notification_preferences")
}

model NotificationQueue {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  channel   NotificationChannel
  status    QueueStatus      @default(PENDING)
  priority  Int              @default(0)
  attempts  Int              @default(0)
  maxAttempts Int            @default(3)
  scheduledAt DateTime?
  processedAt DateTime?
  failedAt  DateTime?
  error     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("notification_queue")
}

model NotificationLog {
  id             String           @id @default(cuid())
  notificationId String?
  userId         String
  type           NotificationType
  channel        NotificationChannel
  status         DeliveryStatus
  provider       String?          // Email provider, SMS provider, etc.
  providerId     String?          // External provider message ID
  error          String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  @@map("notification_logs")
}

enum NotificationType {
  RIDE_REQUEST
  RIDE_ACCEPTED
  RIDE_CANCELLED
  RIDE_COMPLETED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PROMO_CODE
  SECURITY_ALERT
  SYSTEM_UPDATE
  GENERAL
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  COMPLAINED
}
