# Database
# DATABASE_URL="mysql://root:password@localhost:5432/uber_db?schema=public"
DATABASE_URL="mysql://root:1234@localhost:3306/uworld-db?connection_limit=20"

# JWTI w
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Application
PORT=43817
NODE_ENV="development"
FRONTEND_URL="http://localhost:52941"

# Payment Gateways
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Email Service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# SMS Service
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# Push Notifications
FCM_SERVER_KEY="your-fcm-server-key"

# Redis (for caching and sessions)
REDIS_URL="redis://localhost:6379"

# AI Tutor chat quotas (see aitutor.chat entitlement on subscription packages)
# When the user has no aitutor.chat entitlement on their package, this limit applies (default 5 chats per period).
# Set to 0 to block AI Tutor entirely unless the package includes aitutor.chat.
AI_TUTOR_CHAT_LIMIT_WITHOUT_ENTITLEMENT=5
# Period for that default: DAY or MONTH
AI_TUTOR_CHAT_PERIOD_WITHOUT_ENTITLEMENT=DAY
# When a package includes AI Tutor but no numeric limit is stored, fall back to this cap (default 20).
AI_TUTOR_CHAT_FALLBACK_LIMIT=20
