// Generated Prisma Schema
// Source: Ecommerce Compact Schema
// Description: Compact database schema for ecommerce application with table names, primary keys, and relations

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id String @id @default(cuid())
  addresses Addresses[]
  carts Carts[]
  orders Orders[]
  reviews Reviews[]
  wishlists Wishlists[]
}

model Addresses {
  id String @id @default(cuid())
  usersId String
  users Users @relation(fields: [usersId], references: [id])
}

model Categories {
  id String @id @default(cuid())
  parentId String?
  parent Categories? @relation("CategoriesHierarchy", fields: [parentId], references: [id])
  children Categories[] @relation("CategoriesHierarchy")
  productCategories ProductCategories[]
}

model Products {
  id String @id @default(cuid())
  productCategories ProductCategories[]
  productImages ProductImages[]
  productVariants ProductVariants[]
  cartItems CartItems[]
  orderItems OrderItems[]
  reviews Reviews[]
  wishlists Wishlists[]
}

model ProductCategories {
  id String @id @default(cuid())
  productsId String
  products Products @relation(fields: [productsId], references: [id])
  categoriesId String
  categories Categories @relation(fields: [categoriesId], references: [id])
}

model ProductImages {
  id String @id @default(cuid())
  productsId String
  products Products @relation(fields: [productsId], references: [id])
}

model ProductVariants {
  id String @id @default(cuid())
  productsId String
  products Products @relation(fields: [productsId], references: [id])
  cartItems CartItems[]
  orderItems OrderItems[]
}

model Carts {
  id String @id @default(cuid())
  usersId String
  users Users @relation(fields: [usersId], references: [id])
  cartItems CartItems[]
}

model CartItems {
  id String @id @default(cuid())
  cartsId String
  carts Carts @relation(fields: [cartsId], references: [id])
  productsId String
  products Products @relation(fields: [productsId], references: [id])
  productVariantsId String
  productVariants ProductVariants @relation(fields: [productVariantsId], references: [id])
}

model Orders {
  id String @id @default(cuid())
  usersId String
  users Users @relation(fields: [usersId], references: [id])
  orderItems OrderItems[]
  payments Payments[]
  shipments Shipments[]
  reviews Reviews[]
}

model OrderItems {
  id String @id @default(cuid())
  ordersId String
  orders Orders @relation(fields: [ordersId], references: [id])
  productsId String
  products Products @relation(fields: [productsId], references: [id])
  productVariantsId String
  productVariants ProductVariants @relation(fields: [productVariantsId], references: [id])
}

model Payments {
  id String @id @default(cuid())
  ordersId String
  orders Orders @relation(fields: [ordersId], references: [id])
}

model Shipments {
  id String @id @default(cuid())
  ordersId String
  orders Orders @relation(fields: [ordersId], references: [id])
}

model Reviews {
  id String @id @default(cuid())
  productsId String
  products Products @relation(fields: [productsId], references: [id])
  usersId String
  users Users @relation(fields: [usersId], references: [id])
  ordersId String
  orders Orders @relation(fields: [ordersId], references: [id])
}

model Coupons {
  id String @id @default(cuid())
}

model Wishlists {
  id String @id @default(cuid())
  usersId String
  users Users @relation(fields: [usersId], references: [id])
  productsId String
  products Products @relation(fields: [productsId], references: [id])
}